# ============================================================
# Nativo. A diferencia de gonper-app —donde android/ entero esta
# ignorado y por eso la carpeta vive en un solo disco— aqui SI se
# versiona el proyecto Android. Lo unico que queda fuera son los
# secretos de firma y lo que genera el build.
# ============================================================
android/app/*.jks
android/app/*.keystore
android/*.jks
android/*.keystore
android/keystore.properties
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/capacitor-cordova-android-plugins/

ios/App/Pods/
ios/App/App/public/
ios/App/build/
.ios-temp/
android/FIRMA-*.txt

# Los .aab/.apk publicables viven en versiones/, pero no van a git: 5 MB cada
# uno, git no borra nada y se pueden regenerar desde el codigo mas la llave.
versiones/*.aab
versiones/*.apk

# Configuracion de Firebase: no se versiona. Su api_key la marca el escaner de
# secretos de GitHub, y este repo es publico. Cada maquina se lo baja de la
# consola de Firebase (proyecto gonper-studio, app shop.gonperstudio.socio).
android/app/google-services.json

# Igual que el de Android: configuracion de Firebase fuera del repo, que es
# publico y el escaner de secretos marca su api_key.
**/GoogleService-Info.plist
